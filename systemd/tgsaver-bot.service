[Unit]
Description=TgSaverBot Telegram Interface Service
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=tgsaver
Group=tgsaver
WorkingDirectory=/opt/tgsaver
EnvironmentFile=/opt/tgsaver/.env
ExecStart=/opt/tgsaver/.venv/bin/python main.py
Restart=always
RestartSec=5s
KillMode=process
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
